# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Secret used to sign login tokens. Generate a long random value and keep it private.
JWT_SECRET=

# Port the API listens on.
PORT=5000

# Comma-separated origins allowed to call the API (the Vercel frontend URL).
FRONTEND_URL=http://localhost:8000

# How many single-use recovery codes Admin Settings mints on each regeneration.
ADMIN_RECOVERY_CODE_COUNT=8